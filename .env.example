VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ENV=development
VITE_ENABLE_DEMO_SHORTCUTS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_FEEDBACK=true
VITE_ENABLE_ERROR_MONITORING=false

